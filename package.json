{
  "name": "magi",
  "version": "0.10.0",
  "private": true,
  "description": "连接 Codex、DSH 与 Antigravity 的指定会话，支持定向消息、广播通知和 DSH 独立代码外审",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "codex",
    "agent-collaboration",
    "code-review",
    "antigravity"
  ],
  "homepage": "https://github.com/Adrenaline036/Collabridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adrenaline036/Collabridge.git"
  },
  "bugs": {
    "url": "https://github.com/Adrenaline036/Collabridge/issues"
  },
  "type": "module",
  "bin": {
    "magi-message": "./lib/message.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./routing": "./lib/routing.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "tools/transport/push-to-codex.mjs",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "OPERATIONS.md",
    "LICENSE",
    "tools/setup-antigravity.py"
  ],
  "license": "MIT"
}
